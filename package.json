{
  "name": "documentation-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation Toolkit by Grindstone Systems: turn Ignition exports into an engineering reference and an editable manual pack, in the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "oic-docs": "./dist-cli/oic-docs.mjs"
  },
  "files": [
    "dist-cli",
    "agent"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cli": "esbuild cli/oic-docs.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-cli/oic-docs.mjs --banner:js='#!/usr/bin/env node'",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "oic-docs": "tsx cli/oic-docs.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm build:cli",
    "privacy:check": "tsx scripts/privacy-check.ts",
    "oic:media": "tsx scripts/oic-media.ts",
    "oic:check": "tsx scripts/oic-check.ts",
    "demo:backup": "tsx scripts/make-demo-backup.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "docx": "^9.8.1",
    "fflate": "^0.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.10",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.4",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
