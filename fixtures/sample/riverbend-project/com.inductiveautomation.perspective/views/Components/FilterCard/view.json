                }
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "HeadLoss"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "tag",
              "config": {
                "mode": "indirect",
                "tagPath": "[default]Riverbend/Filters/{1}/HeadLoss",
                "references": {
                  "1": "{view.params.filter}"
                }
              }
            }
          }
        }
      }
    ]
  },
  "propConfig": {
    "params.filter": {
      "paramDirection": "input"
    }
  }
