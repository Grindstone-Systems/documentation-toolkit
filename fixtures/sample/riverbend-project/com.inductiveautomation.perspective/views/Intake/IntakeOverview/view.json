{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "width": 1024,
      "height": 768
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {},
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "RawFlow"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "tag",
              "config": {
                "mode": "direct",
                "tagPath": "[default]Riverbend/Intake/RawFlow",
                "fallbackDelay": 2.5
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "RawTurbidity"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "tag",
              "config": {
                "mode": "direct",
                "tagPath": "[default]Riverbend/Intake/RawTurbidity",
                "fallbackDelay": 2.5
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "ScreenDP"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "tag",
              "config": {
                "mode": "direct",
                "tagPath": "[default]Riverbend/Intake/ScreenDP",
                "fallbackDelay": 2.5
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Interlock"
        },
        "props": {},
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({[default]Riverbend/Intake/LowFlowInterlock}, 'State/Alarm', 'State/Normal')"
              }
            }
          }
        }
      }
    ]
  }
}
