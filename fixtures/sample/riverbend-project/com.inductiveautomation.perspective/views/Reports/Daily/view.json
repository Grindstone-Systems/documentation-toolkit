          }
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "Export"
        },
        "props": {},
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tdata = riverbend.reports.dailySummary(system.date.now())\n\tsystem.perspective.download('daily.csv', system.dataset.toCSV(data))"
              }
            }
          }
        }
      }
    ]
  }
}
